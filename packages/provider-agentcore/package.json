{
  "name": "@agent-runtime/provider-agentcore",
  "version": "0.1.0",
  "description": "Bedrock AgentCore (WebSocket) provider for agent-runtime",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-runtime/core": "workspace:*",
    "@agent-runtime/protocol": "workspace:*",
    "ws": "^8.18.0",
    "@smithy/signature-v4": "^5.0.0",
    "@smithy/protocol-http": "^5.0.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-provider-node": "^3.700.0",
    "@smithy/types": "^4.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13"
  }
}
