{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@agent-runtime/core/rxjs": [
        "packages/core/src/rxjs.ts"
      ],
      "@agent-runtime/core/testing": [
        "packages/core/src/testing/index.ts"
      ],
      "@agent-runtime/core": [
        "packages/core/src/index.ts"
      ],
      "@agent-runtime/protocol": [
        "packages/protocol/src/index.ts"
      ],
      "@agent-runtime/stores-memory": [
        "packages/stores/memory/src/index.ts"
      ],
      "@agent-runtime/stores-postgres": [
        "packages/stores/postgres/src/index.ts"
      ],
      "@agent-runtime/providers-managed-agents": [
        "packages/providers/managed-agents/src/index.ts"
      ],
      "@agent-runtime/providers-agentcore": [
        "packages/providers/agentcore/src/index.ts"
      ],
      "@agent-runtime/agentcore-runtime": [
        "packages/agentcore-runtime/src/index.ts"
      ],
      "@agent-runtime/agentcore-runtime/claude-agent-sdk": [
        "packages/agentcore-runtime/src/claude-agent-sdk/index.ts"
      ],
      "@agent-runtime/nestjs": [
        "packages/nestjs/src/index.ts"
      ]
    }
  }
}
